# MySQL
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=auto_ml
MYSQL_USER=automl
MYSQL_PASSWORD=automl123456

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_DEFAULT_BUCKET=automl
S3_DATASETS_BUCKET=auto-ml-datasets
S3_MODELS_BUCKET=auto-ml-models
S3_ANNOTATIONS_BUCKET=auto-ml-annotations
S3_AUGMENTED_BUCKET=auto-ml-augmented

# RabbitMQ
RABBITMQ_USER=automl
RABBITMQ_PASSWORD=automl123456
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=auto_ml_exchange
RABBITMQ_EXCHANGE_TYPE=topic

# Nacos
USE_NACOS=true
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=public
NACOS_DATA_ID=AUTO_ML_CONFIG
NACOS_GROUP=AUTO_ML

# Backend service URLs used by automl_server
MODEL_TRAINER_URL=http://model-trainer:8081
MODEL_DEPLOY_URL=http://model-deploy:8082
AI_PIPELINE_RUNTIME_URL=http://ai-pipeline-runtime:8010
AUTO_AUGMENT_PIPELINE_URL=http://ai-pipeline-runtime:8010

# Backend service ports
AUTOML_SERVER_PORT=45678
MODEL_TRAINER_PORT=8081
MODEL_DEPLOY_PORT=8082
AI_PIPELINE_RUNTIME_PORT=8010
MODEL_TRAINER_TIMEOUT=30
MODEL_DEPLOY_TIMEOUT=60
AI_PIPELINE_RUNTIME_TIMEOUT=120
TASK_STALE_TIMEOUT_SECONDS=7200

# Frontend build
VITE_API_BASE_URL=/api

# Local development overrides
DEV_MODEL_TRAINER_URL=http://127.0.0.1:8081
DEV_MODEL_DEPLOY_URL=http://127.0.0.1:8082
DEV_AI_PIPELINE_RUNTIME_URL=http://127.0.0.1:8010
DEV_AUTO_AUGMENT_PIPELINE_URL=http://127.0.0.1:8010

# Optional runtime tuning
TRAINER_MAX_CONCURRENT=1
