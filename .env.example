# MySQL 配置（主服务使用）
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=auto_ml
MYSQL_USER=automl
MYSQL_PASSWORD=automl123456

# MinIO 配置
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# RabbitMQ 配置
RABBITMQ_USER=automl
RABBITMQ_PASSWORD=automl123456
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=auto_ml_exchange
RABBITMQ_EXCHANGE_TYPE=topic

# Nacos 配置
USE_NACOS=true
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=public
NACOS_DATA_ID=AUTO_ML_CONFIG
NACOS_GROUP=AUTO_ML

# 服务地址（生产/整套 docker-compose 部署使用容器内服务名）
MODEL_TRAINER_URL=http://model-trainer:8080
MODEL_DEPLOY_URL=http://model-deploy:8080
AUTO_AUGMENT_PIPELINE_URL=http://auto-augment-pipeline:8010

# 开发模式（docker-compose.dev.yml 写入 Nacos，供本机直跑服务使用）
DEV_MODEL_TRAINER_URL=http://127.0.0.1:8081
DEV_MODEL_DEPLOY_URL=http://127.0.0.1:8082
DEV_AUTO_AUGMENT_PIPELINE_URL=http://127.0.0.1:8010

# MinIO 服务端点
MINIO_ENDPOINT=http://minio:9000

# 以下环境变量会由 docker-compose 自动设置给各服务
# S3_ACCESS_KEY / S3_SECRET_KEY / S3_ENDPOINT
# RABBITMQ_HOST / RABBITMQ_PORT / RABBITMQ_USER / RABBITMQ_PASSWORD
# NACOS_SERVER_ADDR / NACOS_NAMESPACE / NACOS_DATA_ID / NACOS_GROUP
