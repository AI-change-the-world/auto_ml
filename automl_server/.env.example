# AutoML Server 环境变量配置

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=45678
DEBUG=false
TASK_STALE_TIMEOUT_SECONDS=7200

# Nacos 配置
USE_NACOS=true
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_DATA_ID=AUTO_ML_CONFIG
NACOS_GROUP=AUTO_ML

# 数据库配置（如不使用 Nacos）
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=automl123456
DB_NAME=auto_ml

# RabbitMQ 配置（如不使用 Nacos）
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=automl
RABBITMQ_PASSWORD=automl123456
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=auto_ml_exchange

# S3/MinIO 配置（如不使用 Nacos）
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_DEFAULT_BUCKET=automl
S3_DATASETS_BUCKET=automl-datasets
S3_MODELS_BUCKET=automl-models
S3_ANNOTATIONS_BUCKET=automl-annotations
S3_AUGMENTED_BUCKET=automl-augmented

# AI Pipeline Runtime 配置
MODEL_TRAINER_URL=http://localhost:8081
MODEL_DEPLOY_URL=http://localhost:8082
AI_PIPELINE_RUNTIME_URL=http://localhost:8010
AUTO_AUGMENT_PIPELINE_URL=http://localhost:8010
MODEL_TRAINER_TIMEOUT=30
MODEL_DEPLOY_TIMEOUT=60
AI_PIPELINE_RUNTIME_TIMEOUT=120
AUTO_AUGMENT_PIPELINE_TIMEOUT=120
