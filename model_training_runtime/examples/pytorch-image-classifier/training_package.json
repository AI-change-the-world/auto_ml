{
  "protocol_version": "training-code-package/v1",
  "key": "pytorch-image-classifier",
  "version": "1.0.0",
  "name": "PyTorch Image Classifier",
  "description": "Runnable PyTorch cat-versus-dog classifier for platform data or a script-managed CIFAR-10 download.",
  "runtime": {
    "id": "pytorch-2.5-cu124",
    "kind": "platform_managed"
  },
  "entrypoint": "train.py",
  "entrypoint_symbol": "train",
  "supported_tasks": [
    {
      "task_kind": "classification",
      "data_modalities": [
        "image"
      ],
      "annotation_kinds": [
        "classification"
      ]
    }
  ],
  "input_modes": [
    "platform_dataset",
    "script_managed"
  ],
  "parameters_schema": {
    "type": "object",
    "properties": {
      "epochs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "default": 5
      },
      "batch_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1024,
        "default": 64
      },
      "learning_rate": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1,
        "default": 0.001
      },
      "image_size": {
        "type": "integer",
        "minimum": 16,
        "maximum": 512,
        "default": 32
      },
      "max_samples": {
        "type": "integer",
        "minimum": 2,
        "maximum": 10000,
        "default": 2000
      },
      "num_workers": {
        "type": "integer",
        "minimum": 0,
        "maximum": 8,
        "default": 0
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "default": 42
      }
    },
    "additionalProperties": false
  },
  "output_contract": {
    "artifacts": [
      {
        "role": "model",
        "formats": [
          "onnx"
        ],
        "required": true,
        "deployable": true
      },
      {
        "role": "checkpoint",
        "formats": [
          "pt"
        ],
        "required": false,
        "deployable": false
      }
    ],
    "requires_model_metadata": true
  }
}
